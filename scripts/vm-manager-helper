#!/usr/bin/python3 -I
"""VM Manager privileged helper. Installed root-owned as /usr/libexec/vm-manager/helper by
scripts/setup.sh and run by the app through pkexec (polkit action org.vmmanager.helper, allowed
for group libvirt without a password).

Fixed command whitelist, every argument validated here (never trust the caller):
  helper version
  helper dhcp-release <network> <ipv4> <mac>
      Drop a DHCP lease from the dnsmasq of a libvirt network (dnsmasq's dhcp_release). The bridge
      is resolved from libvirt, and the lease must exist in that network.
  helper sriov-set-numvfs <interface> <n>
      Set the number of SR-IOV VFs of a physical function (sysfs sriov_numvfs). The interface must be
      a PCI device with sriov_totalvfs >= n; changing a non-zero count goes through 0 (kernel rule).
      Refused while one of its VFs is bound to vfio-pci (likely passed through to a running VM).
  helper pam-auth <user>            (password on stdin)
      Check a Linux account's password + account state through PAM, service "vm-manager" ONLY
      (/etc/pam.d/vm-manager, installed by setup.sh; never su/sudo whose pam_rootok would accept
      anyone when run as root). Needed because pam_unix can't check another local user's password
      from the app's non-root process. root (uid 0) is refused. Exit 6 = denied.

Exit codes: 0 ok, 2 bad arguments, 3 missing tool, 4 not found, 5 failed, 6 denied.
"""
import ipaddress
import os
import re
import subprocess
import sys
import xml.etree.ElementTree as ET

VERSION = "3"
PATH = "/usr/sbin:/usr/bin:/sbin:/bin"
NETWORK_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}$")
MAC_RE = re.compile(r"^[0-9a-f]{2}(:[0-9a-f]{2}){5}$")
CLIENTID_RE = re.compile(r"^[0-9a-f]{2}(:[0-9a-f]{2}){0,127}$")
BRIDGE_RE = re.compile(r"^[A-Za-z0-9_.-]{1,15}$")
IFACE_RE = re.compile(r"^[A-Za-z0-9_.-]{1,15}$")
USER_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_.@-]{0,127}[$]?$")
PAM_SERVICE = "vm-manager"


def fail(code, message):
    sys.stderr.write(f"error: {message}\n")
    sys.exit(code)


def which(name):
    for d in PATH.split(":"):
        path = os.path.join(d, name)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def dhcp_release(args):
    if len(args) != 3:
        fail(2, "usage: dhcp-release <network> <ipv4> <mac>")
    network, ip, mac = args[0], args[1], args[2].lower()
    if not NETWORK_RE.match(network):
        fail(2, f"invalid network name {network!r}")
    try:
        address = ipaddress.IPv4Address(ip)
    except ValueError:
        fail(2, f"invalid IPv4 address {ip!r}")
    if not MAC_RE.match(mac):
        fail(2, f"invalid MAC address {mac!r}")
    tool = which("dhcp_release")
    if tool is None:
        fail(3, "dhcp_release is not installed on the host: install dnsmasq-utils (Debian/Ubuntu, RHEL/Fedora) "
                "or dnsmasq (Arch), or re-run scripts/setup.sh")

    try:
        import libvirt
    except ImportError:
        fail(3, "the libvirt Python bindings are not installed for /usr/bin/python3")
    libvirt.registerErrorHandler(lambda _ctx, _err: None, None)
    try:
        conn = libvirt.open("qemu:///system")
    except libvirt.libvirtError as e:
        fail(5, f"cannot connect to libvirt: {e.get_error_message()}")
    try:
        try:
            net = conn.networkLookupByName(network)
        except libvirt.libvirtError:
            fail(4, f"network {network!r} not found")
        if not net.isActive():
            fail(4, f"network {network!r} is not running")
        root = ET.fromstring(net.XMLDesc(0))
        bridge = root.find("bridge")
        bridge = bridge.get("name") if bridge is not None else None
        if not bridge or not BRIDGE_RE.match(bridge):
            fail(4, f"network {network!r} has no bridge")
        if not any(address in ipaddress.ip_interface(f"{el.get('address')}/{el.get('prefix') or el.get('netmask')}").network
                   for el in root.findall("ip") if el.get("family", "ipv4") == "ipv4" and el.get("address")
                   and (el.get("prefix") or el.get("netmask"))):
            fail(2, f"{ip} is not in a subnet of network {network!r}")
        lease = next((l for l in net.DHCPLeases() if l.get("mac", "").lower() == mac and l.get("ipaddr") == ip), None)
        if lease is None:
            fail(4, f"no DHCP lease for {mac} / {ip} in network {network!r}")
    finally:
        conn.close()

    cmd = [tool, bridge, ip, mac]
    clientid = (lease.get("clientid") or "").lower()
    if clientid and CLIENTID_RE.match(clientid):
        cmd.append(clientid)  # dnsmasq matches the lease by client id when the guest sent one
    result = subprocess.run(cmd, capture_output=True, text=True, env={"PATH": PATH, "LC_ALL": "C"}, timeout=20)
    if result.returncode != 0:
        fail(5, f"dhcp_release failed: {(result.stderr or result.stdout).strip() or result.returncode}")
    print(f"released {ip} ({mac}) on {bridge}")


def sriov_set_numvfs(args):
    if len(args) != 2:
        fail(2, "usage: sriov-set-numvfs <interface> <n>")
    iface, count = args
    if not IFACE_RE.match(iface) or iface in (".", ".."):
        fail(2, f"invalid interface name {iface!r}")
    if not count.isdigit() or len(count) > 4:
        fail(2, f"invalid VF count {count!r}")
    count = int(count)
    device = os.path.realpath(f"/sys/class/net/{iface}/device")
    if not device.startswith("/sys/devices/pci") or not os.path.isfile(os.path.join(device, "sriov_totalvfs")):
        fail(4, f"{iface} is not an SR-IOV capable PCI network interface")

    def read(name):
        with open(os.path.join(device, name)) as f:
            return int(f.read().strip() or 0)

    total, current = read("sriov_totalvfs"), read("sriov_numvfs")
    if count > total:
        fail(2, f"{iface} supports at most {total} VFs")
    if count == current:
        print(f"{iface}: {count} VFs")
        return
    for entry in os.listdir(device):
        if entry.startswith("virtfn"):
            driver = os.path.join(device, entry, "driver")
            if os.path.islink(driver) and os.path.basename(os.readlink(driver)) == "vfio-pci":
                fail(5, f"VF {os.path.basename(os.readlink(os.path.join(device, entry)))} of {iface} is bound to "
                        f"vfio-pci (passed through to a VM?): stop the VMs using it first")
    try:
        if current and count:
            with open(os.path.join(device, "sriov_numvfs"), "w") as f:
                f.write("0")
        with open(os.path.join(device, "sriov_numvfs"), "w") as f:
            f.write(str(count))
    except OSError as e:
        fail(5, f"cannot set sriov_numvfs on {iface}: {e.strerror or e}")
    print(f"{iface}: {count} VFs")


def pam_check(service, username, password):
    """Same as backend/app/services/pam_auth.py (kept in sync by hand: the helper can't import the app)"""
    import ctypes
    import ctypes.util
    from ctypes import CFUNCTYPE, POINTER, Structure, byref, c_char_p, c_int, c_size_t, c_void_p, cast, sizeof

    class Msg(Structure):
        _fields_ = [("msg_style", c_int), ("msg", c_char_p)]

    class Resp(Structure):
        _fields_ = [("resp", c_void_p), ("resp_retcode", c_int)]

    conv_t = CFUNCTYPE(c_int, c_int, POINTER(POINTER(Msg)), POINTER(POINTER(Resp)), c_void_p)

    class Conv(Structure):
        _fields_ = [("conv", conv_t), ("appdata_ptr", c_void_p)]

    libpam = ctypes.CDLL(ctypes.util.find_library("pam") or "libpam.so.0")
    libc = ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6")
    libc.calloc.restype, libc.calloc.argtypes = c_void_p, [c_size_t, c_size_t]
    libc.strdup.restype, libc.strdup.argtypes = c_void_p, [c_char_p]
    libpam.pam_start.argtypes = [c_char_p, c_char_p, POINTER(Conv), POINTER(c_void_p)]
    libpam.pam_authenticate.argtypes = libpam.pam_acct_mgmt.argtypes = libpam.pam_end.argtypes = [c_void_p, c_int]
    libpam.pam_strerror.restype, libpam.pam_strerror.argtypes = c_char_p, [c_void_p, c_int]
    user_b, password_b = username.encode(), password.encode()

    @conv_t
    def conv(n, messages, p_response, _data):
        addr = libc.calloc(n, sizeof(Resp))
        if not addr:
            return 5  # PAM_BUF_ERR
        responses = cast(addr, POINTER(Resp))
        for i in range(n):
            style = messages[i].contents.msg_style
            if style == 1:  # PAM_PROMPT_ECHO_OFF
                responses[i].resp = libc.strdup(password_b)
            elif style == 2:  # PAM_PROMPT_ECHO_ON
                responses[i].resp = libc.strdup(user_b)
        p_response[0] = responses
        return 0

    handle = c_void_p()
    conversation = Conv(conv, None)
    rc = libpam.pam_start(service.encode(), user_b, byref(conversation), byref(handle))
    if rc != 0:
        return False, f"pam_start failed ({rc})"
    try:
        rc = libpam.pam_authenticate(handle, 1)  # PAM_DISALLOW_NULL_AUTHTOK
        if rc == 0:
            rc = libpam.pam_acct_mgmt(handle, 1)
        return rc == 0, "" if rc == 0 else (libpam.pam_strerror(handle, rc) or b"").decode(errors="replace")
    finally:
        libpam.pam_end(handle, rc)


def pam_auth(args):
    import pwd
    if len(args) != 1:
        fail(2, "usage: pam-auth <user> (password on stdin)")
    username = args[0]
    if not USER_RE.match(username):
        fail(2, "invalid user name")
    if not os.path.isfile(f"/etc/pam.d/{PAM_SERVICE}"):
        fail(3, f"/etc/pam.d/{PAM_SERVICE} is missing: re-run scripts/setup.sh")
    password = sys.stdin.buffer.read(4097)
    if len(password) > 4096:
        fail(2, "password too long")
    try:
        password = password.decode("utf-8")
    except UnicodeDecodeError:
        fail(2, "the password must be UTF-8")
    if password.endswith("\n"):  # echo pw | helper pam-auth user
        password = password[:-1]
    try:
        if pwd.getpwnam(username).pw_uid == 0:
            fail(6, "root can't log in to VM Manager")
    except KeyError:
        fail(6, "authentication failed")
    ok, reason = pam_check(PAM_SERVICE, username, password)
    if not ok:
        fail(6, reason or "authentication failed")
    print("ok")


COMMANDS = {
    "version": lambda args: print(VERSION),
    "dhcp-release": dhcp_release,
    "sriov-set-numvfs": sriov_set_numvfs,
    "pam-auth": pam_auth,
}


def main():
    if os.geteuid() != 0:
        fail(2, "must run as root (through pkexec)")
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        fail(2, f"usage: helper {{{'|'.join(COMMANDS)}}} ...")
    COMMANDS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
