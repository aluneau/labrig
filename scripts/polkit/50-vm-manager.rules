// Installed by VM Manager (scripts/setup.sh). Members of group "libvirt" (already root-equivalent
// through libvirt) may, without a password:
//  - run the VM Manager helper (/usr/libexec/vm-manager/helper, fixed command whitelist);
//  - start / stop the libvirt daemons and their sockets (monolithic libvirtd or modular virt*d).
polkit.addRule(function (action, subject) {
    if (!subject.isInGroup("libvirt")) {
        return undefined;
    }
    if (action.id == "org.vmmanager.helper") {
        return polkit.Result.YES;
    }
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit") || "";
        var verb = action.lookup("verb") || "";
        if ((verb == "start" || verb == "stop") &&
            /^(libvirtd|virt(qemu|network|storage|nodedev|secret|nwfilter|interface)d)(-ro|-admin)?\.(service|socket)$/.test(unit)) {
            return polkit.Result.YES;
        }
    }
    return undefined;
});
